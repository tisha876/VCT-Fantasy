rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Gameweeks are public read, admin write only
    match /gameweeks/{gwId} {
      allow read: if request.auth != null;
      allow write: if false; // managed via Admin SDK / Functions
    }

    // Leagues: members can read; anyone auth'd can create
    match /leagues/{leagueId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.members;

      // Rosters: only the owner can write their own roster
      match /rosters/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /gameweekScores/{scoreId} {
        allow read: if request.auth != null;
        allow write: if false; // written by Functions only
      }

      match /transfers/{transferId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /h2h/{pairId} {
        allow read: if request.auth != null;
        allow write: if false; // written by Functions only
      }
    }

    // Notifications: users read/write their own
    match /notifications/{notifId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    match /gameweekHistory/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // written by Functions only
    }
  }
}
