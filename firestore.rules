rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // ── Gameweeks ──────────────────────────────────────────────────────────
    match /gameweeks/{gwId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write gameweeks
      allow write: if false;
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── Gameweek history ───────────────────────────────────────────────────
    match /gameweekHistory/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── Leagues ────────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      // Any auth'd user can read leagues they're in
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      // Create: authenticated user sets themselves as creator + member
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.members;

      // Update: only existing members can update (e.g. join adds themselves)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      // ── Rosters ──────────────────────────────────────────────────────────
      match /rosters/{userId} {
        allow read:  if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Gameweek scores (read-only for members) ───────────────────────────
      match /gameweekScores/{scoreId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members;
        allow write: if false; // Only Cloud Functions
      }

      // ── Transfers ────────────────────────────────────────────────────────
      match /transfers/{transferId} {
        allow read:  if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      // ── H2H records ───────────────────────────────────────────────────────
      match /h2h/{pairId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members;
        allow write: if false;
      }
    }
  }
}
